function divide(a, b) {
 return new Promise((resolve, reject) => {
 if (b === 0)
 reject("Error: denominator cannot be zero");
 else
 resolve(a / b);
 });
}
divide(20, 4)
 .then(result => console.log("20 / 4 =", result))
 .catch(err => console.log(err));
divide(10, 0)
 .then(result => console.log("10 / 0 =", result))
 .catch(err => console.log(err));
