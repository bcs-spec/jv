import java.util.Scanner;
class InvalidDateException extends Exception {
 InvalidDateException(String msg) {
 super(msg);
 }
}
class MyDate {
 int day, month, year;
 void accept(int d, int m, int y) throws InvalidDateException {
 if (!isValid(d, m, y))
 throw new InvalidDateException(
 "InvalidDateException: " + d + "/" + m + "/" + y + " is not a valid date");
 day = d;
 month = m;
 year = y;
 }
 static boolean isLeap(int y) {
 return (y % 4 == 0 && y % 100 != 0) || (y % 400 == 0);
 }
 static boolean isValid(int d, int m, int y) {
 if (y < 1 || m < 1 || m > 12 || d < 1) return false;
 int[] days = {31, isLeap(y) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
 return d <= days[m - 1];
 }
 void display() {
 System.out.printf("Date: %02d/%02d/%04d%n", day, month, year);
 }
}
public class MyDateDemo {
 public static void main(String[] args) {
 Scanner sc = new Scanner(System.in);
 System.out.print("Enter date as dd,mm,yyyy: ");
 String[] parts = sc.nextLine().trim().split(",");
 try {
 int d = Integer.parseInt(parts[0].trim());
 int m = Integer.parseInt(parts[1].trim());
 int y = Integer.parseInt(parts[2].trim());
 MyDate date = new MyDate();
 date.accept(d, m, y);
 date.display();
 } catch (InvalidDateException e) {
 System.out.println(e.getMessage());
 } catch (Exception e) {
 System.out.println("Please enter the date in dd,mm,yyyy format.");
 }
 sc.close();
 }
}
